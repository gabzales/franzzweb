rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FRANZZ Orbit accesses Firestore only from its Vercel server using Firebase Admin SDK.
    // Admin SDK is authorized by Google Cloud IAM and bypasses these client security rules.
    // Do not expose the orbitStore collection to public web/mobile clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
