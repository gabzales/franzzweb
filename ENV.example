# Copy these as separate Environment Variables in Vercel. Replace every placeholder.
SESSION_SECRET=GENERATE_RANDOM_SECRET_MIN_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
GEMINI_API_KEY=PASTE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Optional backup model. Leave blank if not needed.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
FIREBASE_PROJECT_ID=franzzorbit
# Paste the entire NEW service-account JSON into this variable in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=PASTE_ENTIRE_NEW_SERVICE_ACCOUNT_JSON
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON: use one credential variable, never both.
# FIREBASE_SERVICE_ACCOUNT_BASE64=PASTE_BASE64_OF_NEW_SERVICE_ACCOUNT_JSON

# Optional image generation/editing model (default: gemini-nano-banana-2.1)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
